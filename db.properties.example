# ==============================================================
# PLANTILLA DE CONFIGURACIÓN DE BASE DE DATOS DUAL (TIENDA GAMER)
# ==============================================================
# Renombra este archivo como 'db.properties' en la raíz del proyecto.
# ==============================================================

# --- 1. Conexión Principal (Nube / Web - Aiven / Railway / AWS) ---
db.host=mysql-xxxx-tiendagamer.a.aivencloud.com
db.port=20448
db.name=defaultdb
db.user=avnadmin
db.password=TU_PASSWORD_NUBE
db.ssl=true

# --- 2. Conexión de Respaldo Automático (Localhost / XAMPP / MySQL) ---
# Se activa automáticamente si la nube no está disponible
db.fallback.enabled=true
db.fallback.host=localhost
db.fallback.port=3306
db.fallback.name=tiendagamer_database
db.fallback.user=root
db.fallback.password=TU_PASSWORD_LOCAL
db.fallback.ssl=false
